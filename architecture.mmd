
flowchart TB
    User["Users / Internet"]
    IGW["Internet Gateway"]
    ALB["Application Load Balancer"]

    subgraph AWS["AWS Cloud - Region us-east-1"]
        subgraph VPC["Amazon VPC - 10.0.0.0/16"]

            subgraph AZ1["Availability Zone 1"]
                PUB1["Public Subnet"]
                APP1["Private Application Subnet"]
                EC2A["EC2 Instance - AZ 1"]
                DB1["Private Database Subnet"]
                RDS1[("RDS Primary")]
            end

            subgraph AZ2["Availability Zone 2"]
                PUB2["Public Subnet"]
                APP2["Private Application Subnet"]
                EC2B["EC2 Instance - AZ 2"]
                DB2["Private Database Subnet"]
                RDS2[("RDS Standby")]
            end

            ASG["EC2 Auto Scaling Group"]
            DBGROUP["RDS Multi-AZ Deployment"]
        end
    end

    User --> IGW
    IGW --> ALB
    ALB --> PUB1
    ALB --> PUB2
    PUB1 --> APP1
    PUB2 --> APP2
    APP1 --> EC2A
    APP2 --> EC2B

    ASG -. manages .-> EC2A
    ASG -. manages .-> EC2B

    EC2A --> RDS1
    EC2B --> RDS1
    DBGROUP -.-> RDS1
    DBGROUP -.-> RDS2
    RDS1 <-->|Synchronous replication| RDS2
