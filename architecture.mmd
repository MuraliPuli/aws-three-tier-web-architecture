
flowchart TB
    U["Users / Internet"]

    subgraph AWS["AWS Cloud"]
        subgraph VPC["Amazon VPC"]
            IGW["Internet Gateway"]

            subgraph PUBLIC["Public Subnets - Multi-AZ"]
                ALB["Application Load Balancer"]
            end

            subgraph PRIVATE_APP["Private Application Subnets"]
                ASG["EC2 Auto Scaling Group"]
                EC2A["EC2 Instance - AZ 1"]
                EC2B["EC2 Instance - AZ 2"]
            end

            subgraph PRIVATE_DB["Private Database Subnets"]
                RDS[("Amazon RDS")]
            end
        end
    end

    U --> IGW
    IGW --> ALB
    ALB --> EC2A
    ALB --> EC2B
    ASG -. manages .-> EC2A
    ASG -. manages .-> EC2B
    EC2A --> RDS
    EC2B --> RDS

    classDef users fill:#E8EEF7,stroke:#46658F,color:#19365C,stroke-width:2px
    classDef network fill:#DCEBFA,stroke:#3981C6,color:#174A78,stroke-width:2px
    classDef compute fill:#FFF0D9,stroke:#D99128,color:#704500,stroke-width:2px
    classDef database fill:#E6F4E9,stroke:#39945A,color:#185B30,stroke-width:2px

    class U users
    class IGW,ALB network
    class ASG,EC2A,EC2B compute
    class RDS database

    style AWS fill:#F8FAFC,stroke:#64748B,stroke-width:2px
    style VPC fill:#EEF4FA,stroke:#3976A8,stroke-width:2px
    style PUBLIC fill:#EAF3FC,stroke:#3981C6,stroke-width:1px
    style PRIVATE_APP fill:#FFF7E9,stroke:#D99128,stroke-width:1px
    style PRIVATE_DB fill:#EDF8EF,stroke:#39945A,stroke-width:1px
